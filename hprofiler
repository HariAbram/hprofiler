@cli.command()
@click.argument("trace_file", type=click.Path(exists=True))
@click.option("--kernel", "-k", default=None, metavar="PATTERN",
              help="Only dump kernels whose name contains PATTERN (case-insensitive substring).")
@click.option("--output", "-o", default=None, metavar="FILE",
              help="Write to FILE instead of stdout.")
@click.option("--list", "list_only", is_flag=True, default=False,
              help="List available kernel names and exit.")
def disasm(trace_file, kernel, output, list_only):
    """Dump kernel disassembly from a saved trace JSON to a file or stdout.

    The trace must have been recorded with --disasm (or viewed with --disasm)
    so that assembly data is embedded in the JSON.

    \b
    Examples:
      hprofiler disasm trace.json                          # all kernels to stdout
      hprofiler disasm trace.json --list                   # list kernel names
      hprofiler disasm trace.json -k kernel1               # filter by name
      hprofiler disasm trace.json -o kernels.asm           # write to file
      hprofiler disasm trace.json -k kernel1 -o k1.asm
    """
    from src.ui.app import load_trace_from_json
    trace = load_trace_from_json(trace_file, collect_disasm=False)

    if not trace.disasm:
        click.echo("[hprofiler] No disassembly in this trace. "
                   "Re-run with --disasm to collect it.", err=True)
        raise SystemExit(1)

    names = sorted(trace.disasm)
    if kernel:
        names = [n for n in names if kernel.lower() in n.lower()]
        if not names:
            click.echo(f"[hprofiler] No kernels matching '{kernel}'.", err=True)
            raise SystemExit(1)

    if list_only:
        for n in names:
            kd = trace.disasm[n]
            click.echo(f"{n}  [{kd.arch}, {len(kd.lines)} insns]")
        return

    lines_out = []
    for name in names:
        kd = trace.disasm[name]
        lines_out.append(f"; ── {name}  [{kd.arch}]  {len(kd.lines)} instructions ──")
        lines_out.append(f"; source: {kd.source}")
        lines_out.append("")
        for ln in kd.lines:
            lines_out.append(ln.raw if ln.raw else f"\t{ln.mnemonic}  {ln.operands}")
        lines_out.append("")

    text = "\n".join(lines_out)
    if output:
        Path(output).write_text(text)
        click.echo(f"[hprofiler] Disasm written to: {output} ({len(names)} kernel(s))", err=True)
    else:
        click.echo(text)


@cli.command()
@click.argument("trace_file", type=click.Path(exists=True))
@click.option("--baseline", default=None, type=click.Path(exists=True), metavar="TRACE",
              help="A trace from the same program at a lower rank/thread count, "
                   "used to compute Computational Scaling.")
@click.option("--interconnect-bw", default=None, type=float, metavar="GB/S",
              help="Peak interconnect bandwidth (GB/s) to compare achieved NCCL bus "
                   "bandwidth against.")
@click.option("--critical-path/--no-critical-path", "use_cp", default=True, show_default=True,
              help="Also run critical-path analysis to compute Serialization Efficiency.")
def efficiency(trace_file, baseline, interconnect_bw, use_cp):
    """Print a POP-style parallel efficiency breakdown for a saved trace.

    Decomposes efficiency the way the POP (Performance Optimisation and
    Productivity) Centre of Excellence standard metrics do -- Load Balance,
    Communication Efficiency, Parallel Efficiency -- computed directly from
    the trace with no offline network simulator, plus GPU and NCCL
    efficiency layers specific to hprofiler. Serialization Efficiency
    additionally requires critical-path analysis (run automatically unless
    --no-critical-path); Computational Scaling requires --baseline. See
    DOCUMENTATION.md for the exact formulas and their approximations.

    \b
    Examples:
      hprofiler efficiency trace.json
      hprofiler efficiency trace.json --baseline trace_1rank.json
      hprofiler efficiency trace.json --interconnect-bw 300
    """
    from src.ui.app import load_trace_from_json
    from src.analysis import pop_efficiency as pe

    trace = load_trace_from_json(trace_file, collect_disasm=True)
    baseline_trace = load_trace_from_json(baseline, collect_disasm=False) if baseline else None

    cp_report = None
    if use_cp:
        from src.analysis import criticalpath
        try:
            cp_report = criticalpath.analyze(trace)
        except Exception as e:
            click.echo(f"[hprofiler][warn] critical-path analysis failed: {e}", err=True)

    report = pe.analyze(trace, baseline=baseline_trace,
                         nccl_peak_bw_gbs=interconnect_bw, critical_path=cp_report)

    def pct(x):
        return f"{100*x:5.1f}%" if x is not None else "   n/a"

    click.echo(f"\n{'='*64}")
    click.echo(f"  POP-style Efficiency Breakdown: {trace_file}")
    click.echo(f"{'='*64}")
    click.echo(f"  Ranks/processes observed : {len(report.per_rank_useful_ns)}")
    click.echo(f"\n  Global Efficiency           : {pct(report.global_efficiency)}")
    click.echo(f"    Parallel Efficiency       : {pct(report.parallel_efficiency)}")
    click.echo(f"      Load Balance            : {pct(report.load_balance)}")
    click.echo(f"      Communication Efficiency : {pct(report.comm_efficiency)}")
    click.echo(f"        Serialization Efficiency: {pct(report.serialization_efficiency)}")
    click.echo(f"        Transfer Efficiency (proxy): {pct(report.transfer_efficiency)}")
    for cat, eff in sorted(report.transfer_efficiency_by_category.items()):
        click.echo(f"          {cat:<10}          : {pct(eff)}")
    click.echo(f"    Computational Scaling     : {pct(report.computational_scaling)}")
    if report.gpu_efficiency is not None:
        click.echo(f"\n  GPU Efficiency (roofline)  : {pct(report.gpu_efficiency)}")
    if report.nccl_bus_bw_gbs is not None:
        click.echo(f"\n  NCCL achieved bus BW       : {report.nccl_bus_bw_gbs:.1f} GB/s")
        if report.nccl_efficiency is not None:
            click.echo(f"  NCCL Efficiency            : {pct(report.nccl_efficiency)}")
    if report.notes:
        click.echo(f"\n  Notes:")
        for n in report.notes:
            click.echo(f"    - {n}")
    click.echo(f"{'='*64}\n")


@cli.command("critical-path")
@click.argument("trace_file", type=click.Path(exists=True))
@click.option("--top", "-n", default=15, show_default=True,
              help="Number of top categories to show in each breakdown.")
@click.option("--export", default=None, type=click.Path(), metavar="FILE",
              help="Write the trace back out as Chrome Trace JSON with critical-path "
                   "spans tagged on_critical_path=1 and path_confidence=<tier>, "
                   "for highlighting in Perfetto.")
def critical_path_cmd(trace_file, top, export):
    """Compute and print the N-way cross-runtime critical path for a saved trace.

    Builds a dependency graph over every captured span (CUDA/ROCm/OpenCL/
    OpenMP/MPI/NCCL) using each backend's known synchronization semantics --
    stream ordering, device syncs, MPI/NCCL send/recv and collective pairing
    (using resolved MPI_ANY_SOURCE/ANY_TAG status data and real communicator
    identity when available, not just call-order heuristics), OpenMP
    barriers -- not arbitrary data-flow, then finds the real observed
    critical path via a formal DAG longest-path computation (provably the
    globally-best explanatory chain, not a locally-greedy approximation of
    one), and attributes idle time on that path to whichever span was being
    waited on. Every hop is also tagged with how directly it's proven --
    certain (hardware/runtime-enforced or an explicit id the hook itself
    assigned) down to medium (call-order matching with no stronger
    evidence available) -- shown in the "Path evidence strength" section
    below. Single-node only (see DOCUMENTATION.md).

    \b
    Examples:
      hprofiler critical-path trace.json
      hprofiler critical-path trace.json --export trace.critpath.json
    """
    from src.ui.app import load_trace_from_json
    from src.analysis import criticalpath as cpmod

    trace = load_trace_from_json(trace_file, collect_disasm=False)
    report = cpmod.analyze(trace)

    def fmt_ns(ns):
        if ns >= 1_000_000_000:
            return f"{ns/1e9:.3f}s"
        if ns >= 1_000_000:
            return f"{ns/1e6:.2f}ms"
        if ns >= 1_000:
            return f"{ns/1e3:.1f}us"
        return f"{ns}ns"

    click.echo(f"\n{'='*64}")
    click.echo(f"  Critical Path Analysis: {trace_file}")
    click.echo(f"{'='*64}")
    click.echo(f"  Path length (spans) : {len(report.path_span_indices)}")
    click.echo(f"  Wall time           : {fmt_ns(report.wall_ns)}")
    click.echo(f"  Time accounted for  : {fmt_ns(report.total_path_ns)}")

    click.echo(f"\n  Time ON the critical path, by category (productive work):")
    for cat, ns in sorted(report.time_on_path_by_category.items(), key=lambda kv: -kv[1])[:top]:
        click.echo(f"    {cat:<12} {fmt_ns(ns):>12}")

    breakdown = report.confidence_breakdown_ns()
    if breakdown:
        conf_total = sum(breakdown.values())
        click.echo(f"\n  Path evidence strength (how directly each hop is proven, not guessed):")
        for tier in ("certain", "high", "medium", "low"):
            ns = breakdown.get(tier)
            if ns is None:
                continue
            pct = 100.0 * ns / conf_total if conf_total else 0.0
            click.echo(f"    {tier:<12} {fmt_ns(ns):>12}  ({pct:5.1f}%)")

    if report.wait_caused_by_category:
        click.echo(f"\n  Idle time on the critical path, blamed by category (what it was waiting on):")
        for cat, ns in report.top_blame(top):
            click.echo(f"    {cat:<12} {fmt_ns(ns):>12}")
    else:
        click.echo(f"\n  No idle gaps on the critical path -- fully back-to-back.")

    if report.notes:
        click.echo(f"\n  Notes:")
        for n in report.notes:
            click.echo(f"    - {n}")

    if export:
        from src.output import chrome_trace
        on_path = {id(report.spans[i]) for i in report.path_span_indices}
        # path_edge_confidence[i-1] is the confidence of the edge explaining
        # path[i]'s inclusion (path[0], the root of the backward walk, has
        # none -- see CriticalPathReport.confidence_breakdown_ns).
        conf_by_id = {
            id(report.spans[report.path_span_indices[i]]): report.path_edge_confidence[i - 1]
            for i in range(1, len(report.path_span_indices))
        }
        for s in trace.spans:
            if id(s) in on_path:
                s.tags["on_critical_path"] = "1"
                if id(s) in conf_by_id:
                    s.tags["path_confidence"] = conf_by_id[id(s)]
        chrome_trace.write(trace, export, pretty=True)
        click.echo(f"\n  Annotated trace written to: {export}")

    click.echo(f"{'='*64}\n")


@cli.command("merge-nodes")
@click.argument("trace_files", type=click.Path(exists=True), nargs=-1, required=True)
@click.option("-o", "--output", required=True, type=click.Path(),
              help="Where to write the merged trace (Chrome Trace JSON).")
@click.option("--offset-ns", multiple=True, type=int, metavar="NS",
              help="Explicit clock offset for a node, in ns, same order as TRACE_FILES "
                   "(overrides any HPROFILER_CLOCK_SYNC counters in that trace). "
                   "Omit for a node to use its embedded counters (or 0 for node 0, "
                   "the assumed reference).")
def merge_nodes_cmd(trace_files, output, offset_ns):
    """Merge multiple per-node traces from a multi-node run onto one timeline.

    hprofiler's collector is a local socket, so a multi-node job produces
    one independent trace file per node (profile each node separately,
    e.g. via your job launcher's per-node wrapper, then merge here). The
    first TRACE_FILES argument is treated as the reference node (offset
    0); every other node's clock offset relative to it comes from
    HPROFILER_CLOCK_SYNC counters embedded in that trace (see the `mpi`
    backend's clock-sync section in DOCUMENTATION.md -- off by default,
    set HPROFILER_CLOCK_SYNC=1 when running each node to capture them) or
    from --offset-ns if given explicitly.

    pid is remapped into a per-node-unique namespace so same-numbered
    pids from different physical nodes are never conflated; MPI rank=/
    peer= tags are left untouched (already globally unique across the
    whole job). After merging, checks that no matched MPI send/receive
    pair violates causality -- a violation usually means a wrong clock
    offset, printed as a warning rather than silently trusted.

    \b
    Examples:
      hprofiler merge-nodes node0.json node1.json node2.json -o merged.json
      hprofiler merge-nodes node0.json node1.json -o merged.json --offset-ns 0 --offset-ns 15000
    """
    from src.ui.app import load_trace_from_json
    from src.analysis import multinode as mn
    from src.output import chrome_trace

    nodes = []
    for i, path in enumerate(trace_files):
        trace = load_trace_from_json(path, collect_disasm=False)
        if i < len(offset_ns):
            offset = offset_ns[i]
            error_bound = 0
        elif i == 0:
            offset, error_bound = 0, 0
        else:
            est = mn.offset_from_counters(trace)
            if est is None:
                click.echo(f"  Warning: {path} has no HPROFILER_CLOCK_SYNC counters and "
                           f"no --offset-ns given -- merging at an uncorrected 0 offset.")
                offset, error_bound = 0, 0
            else:
                offset, error_bound = est.offset_ns, est.error_bound_ns
                click.echo(f"  {path}: offset={offset}ns (±{error_bound}ns from "
                           f"embedded HPROFILER_CLOCK_SYNC measurement)")
        nodes.append(mn.NodeTrace(trace=trace, offset_ns=offset, error_bound_ns=error_bound,
                                  label=str(path)))

    merged, warnings = mn.merge_traces(nodes)
    for w in warnings:
        click.echo(f"  Warning: {w}")

    problems = mn.validate_causality(merged)
    if problems:
        click.echo(f"\n  Warning: {len(problems)} causality violation(s) found after merging "
                   f"(likely a wrong clock offset for one of these nodes):")
        for p in problems[:10]:
            click.echo(f"    - {p}")
        if len(problems) > 10:
            click.echo(f"    ... and {len(problems) - 10} more")

    chrome_trace.write(merged, output, pretty=True)
    click.echo(f"\n  Merged {len(trace_files)} node(s), {len(merged.spans)} spans "
              f"-> {output}")


@cli.command()
def backends():
    """List all backends and their availability on this system.

    Shows whether each backend's required library or tool is present. If a
    backend is unavailable, a hint for installing the missing dependency is
    printed. Use the Name or any listed alias with --backend.

    \b
    Aliases accepted by --backend:
      omp=openmp   hip=rocm   cl=opencl   perf=cpu   hwc=likwid
    """
    from src.backends import ALL_BACKENDS

    # reverse-map: canonical name → aliases
    reverse_aliases: dict[str, list[str]] = {}
    for alias, canon in _ALIASES.items():
        reverse_aliases.setdefault(canon, []).append(alias)

    click.echo("\nAvailable backends:\n")
    for name, cls in ALL_BACKENDS.items():
        backend_obj = cls()
        ok = backend_obj.is_available()
        if ok:
            status = click.style("✓", fg="green") + "  available  "
        else:
            status = click.style("✗", fg="red") + "  unavailable"
        aliases = reverse_aliases.get(name, [])
        alias_str = f"  [alias: {', '.join(aliases)}]" if aliases else ""
        click.echo(f"  {name:<10}  {status}  {backend_obj.description}{alias_str}")

        # Extra hint for OpenMP when libomp is missing
        note = getattr(backend_obj, "availability_note", lambda: "")()
        if note:
            click.echo(f"  {'':10}     {'':13} → {click.style(note, fg='yellow')}")

    click.echo()


@cli.command()
@click.option("--build-dir", default="build", show_default=True,
              help="CMake build directory")
@click.option("--jobs", "-j", default=os.cpu_count() or 4, show_default=True,
              help="Parallel build jobs")
def build(build_dir, jobs):
    """Build the C hook libraries (CUDA, OpenCL, OpenMP, ROCm, NCCL, MPI).

    Runs CMake to compile the hook shared libraries into build/lib/. Only
    hooks whose required headers are detected at configure time are built
    (e.g. libhprofiler_mpi.so requires MPI headers).

    \b
    Libraries produced in build/lib/:
      libhprofiler_cuda.so    CUDA Runtime + Driver API + NVTX
      libhprofiler_opencl.so  OpenCL ICD
      libhprofiler_ompt.so    OpenMP OMPT tool (requires libomp, not libgomp)
      libhprofiler_rocm.so    ROCm/HIP (requires ROCm at /opt/rocm)
      libhprofiler_nccl.so    NCCL collectives (no NCCL headers needed)
      libhprofiler_mpi.so     MPI PMPI wrappers (requires mpicc)

    Re-run after pulling new hook code. Existing .so files are overwritten.
    """
    import subprocess
    build_path = Path(build_dir)
    build_path.mkdir(parents=True, exist_ok=True)

    root = Path(__file__).parent.resolve()

    click.echo(f"[hprofiler] Configuring CMake in {build_path} ...")
    r = subprocess.run(
        ["cmake", str(root.resolve()), "-DCMAKE_BUILD_TYPE=Release"],
        cwd=build_path,
    )
    if r.returncode != 0:
        raise click.ClickException("CMake configure failed")

    click.echo(f"[hprofiler] Building with {jobs} jobs ...")
    r = subprocess.run(["cmake", "--build", ".", f"-j{jobs}"], cwd=build_path)
    if r.returncode != 0:
        raise click.ClickException("Build failed")

    # Copy libs to build/lib in project root
    lib_src = build_path / "lib"
    lib_dst = root / "build" / "lib"
    lib_dst.mkdir(parents=True, exist_ok=True)

    import shutil
    for so in lib_src.glob("*.so*"):
        dst = lib_dst / so.name

        if so.resolve() == dst.resolve():
            click.echo(f"  → {dst} already in place")
            continue

        shutil.copy2(so, dst)
        click.echo(f"  → {dst}")

    click.echo(click.style("[hprofiler] Build complete.", fg="green"))


if __name__ == "__main__":
    cli()
